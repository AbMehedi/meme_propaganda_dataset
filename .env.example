# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Apify API token (required for download_and_hash.py)
# Get yours at: https://console.apify.com/ → Settings → Integrations
APIFY_TOKEN=your_apify_api_token_here
DATASET_ID=your_apify_dataset_id_here

# Ollama host URL (optional — automatically set inside Docker)
# Only override if Ollama runs on a non-default address.
# OLLAMA_HOST=http://localhost:11434
