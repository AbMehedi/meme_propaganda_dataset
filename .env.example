# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Apify API token (required for download_and_hash.py)
# Get yours at: https://console.apify.com/ → Settings → Integrations
APIFY_TOKEN=your_apify_api_token_here

# One or more Apify Dataset IDs — comma-separated, no spaces
# Each ID corresponds to a separate Apify scrape run (e.g. different pages or time periods).
# All datasets will be ingested into the same propaganda_dataset.db.
# Example:
#   DATASET_IDS=abc123,def456,ghi789
DATASET_IDS=your_dataset_id_1,your_dataset_id_2

# Folder to store downloaded meme images (default: raw_images_new)
IMAGE_DIR=raw_images_new
